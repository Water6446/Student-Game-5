# ---- Client-safe (exposed to the browser) ----------------------------------
# These are PUBLIC by design. Security comes from RLS + SECURITY DEFINER RPCs,
# never from hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the NEW publishable key (sb_publishable_...) — the replacement for the
# legacy anon key. The legacy anon key still works but is being deprecated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Public base URL used to build the student join link / QR (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testing escape hatch, currently ON by default: /host offers a "Skip email"
# button that signs in anonymously, and anonymous users reach the host dashboard.
# Supabase's email quota is rate-limited, which makes the magic-link flow painful
# to test against.
#
# BEFORE A PUBLIC DEPLOY, set this to "false" so hosting privileges are tied to a
# verified identity — and note that migration 0008_temp_allow_anon_host.sql
# relaxes the SERVER side independently of this flag, so it needs its own
# migration at the same time. Until both are done, /host is open by design.
NEXT_PUBLIC_ALLOW_ANON_HOST=true

# ---- Server-only secrets (NEVER prefixed NEXT_PUBLIC, NEVER sent to client) --
# Authorises the username -> email lookup used by /api/auth/sign-in, so students
# and hosts can sign in with a username instead of an email address.
#
# Generate with:  openssl rand -hex 32
# Then store the SAME value in the database (SQL editor, as the owner):
#   insert into public.app_secrets (key, value) values ('username_lookup', '<value>')
#   on conflict (key) do update set value = excluded.value;
#
# Deliberately NOT the service_role key: if this one leaks the damage is
# username -> email enumeration, whereas service_role would be the whole
# database. See supabase/migrations/0021_username_login.sql.
#
# Leave unset and username sign-in simply turns itself off — the form then
# accepts email addresses only. It fails closed, never open.
USERNAME_LOOKUP_SECRET=


# The secret key (new format: sb_secret_..., formerly the service_role key)
# bypasses RLS. It is NOT required by the app (all privileged actions are
# host-only RPCs). It is used ONLY by the optional scripts/security-check.ts to
# set up/tear down a disposable test session. Leave unset in dev and production.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a pre-existing host (magic-link) account email used by the live
# security check script to obtain a real host session.
SECURITY_CHECK_HOST_EMAIL=
