# ---- Client-safe (exposed to the browser) ----------------------------------
# These are PUBLIC by design. Security comes from RLS + SECURITY DEFINER RPCs,
# never from hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the NEW publishable key (sb_publishable_...) — the replacement for the
# legacy anon key. The legacy anon key still works but is being deprecated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Public base URL used to build the student join link / QR (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (NEVER prefixed NEXT_PUBLIC, NEVER sent to client) --
# The secret key (new format: sb_secret_..., formerly the service_role key)
# bypasses RLS. It is NOT required by the app (all privileged actions are
# host-only RPCs). It is used ONLY by the optional scripts/security-check.ts to
# set up/tear down a disposable test session. Leave unset in dev and production.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a pre-existing host (magic-link) account email used by the live
# security check script to obtain a real host session.
SECURITY_CHECK_HOST_EMAIL=
